<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!--
        Lets the Advertising ID be read on Android 13 and above. Without it Play Services
        returns a zeroed identifier and every event is attributed to the same non-user.
    -->
    <uses-permission android:name="com.google.android.gms.permission.AD_ID" />
</manifest>
